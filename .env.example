# Copy to .env and fill in.
#
# NOTE: Vite inlines every VITE_* variable into the client bundle at build
# time. These values are visible to anyone who opens DevTools on the deployed
# site. Keeping them here is configuration hygiene, NOT a secret store — never
# put an actual secret behind a VITE_ prefix.
VITE_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id

# Supabase auth. The publishable key is meant to ship to browsers — row level
# security, not obscurity, is what protects the data behind it. The service
# role key is a real secret and must never appear here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
