# Copy to .env and fill in.
#
# NOTE: Vite inlines every VITE_* variable into the client bundle at build
# time. These values are visible to anyone who opens DevTools on the deployed
# site. Keeping them here is configuration hygiene, NOT a secret store — never
# put an actual secret behind a VITE_ prefix.

# Supabase auth. The publishable key is meant to ship to browsers — row level
# security, not obscurity, is what protects the data behind it. The service
# role key is a real secret and must never appear here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Stripe Payment Link for the one-time unlock. Public by design: it identifies
# a price, not an account. The app appends client_reference_id (the Supabase
# user id) so the webhook can tie the payment back to an account.
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_link_id

# There is deliberately no VITE_WEBHOOK_URL. Generation goes through the
# `generate` Edge Function, which checks the caller's session and purchase
# before forwarding to n8n. These two secrets are set on the Supabase project
# (Project Settings -> Edge Functions -> Secrets), never here:
#
#   N8N_WEBHOOK_URL        the n8n production webhook URL
#   STRIPE_WEBHOOK_SECRET  whsec_... from the Stripe webhook endpoint
